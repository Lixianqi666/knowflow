# === 必填 ===

# JWT 签名密钥（openssl rand -hex 32）
SECRET_KEY=change-me-to-a-random-64-hex-string

# LLM 配置
LLM_API_KEY=your-api-key
LLM_MODEL=openai/deepseek-ai/DeepSeek-V3
LLM_BASE_URL=https://api.siliconflow.cn/v1

# Embedding 配置
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=your-api-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# === 可选 ===

# 数据库密码（默认 knowflow）
DB_PASSWORD=knowflow

# CORS 允许的源（生产环境改为实际域名）
# CORS_ORIGINS=https://your-domain.com

# 精排（需在 backend 容器内安装 FlagEmbedding）
RERANKER_ENABLED=false

# Langfuse 可观测性
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Grafana 管理员密码（默认 admin）
# GRAFANA_PASSWORD=your-password
